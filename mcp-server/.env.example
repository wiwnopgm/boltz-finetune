# OpenAI API Configuration for LLM client
LLM_API_KEY=your-api-key-here
MODEL_CHOICE=gpt-4o-mini
BASE_URL=https://api.openai.com/v1

# Uncomment the following line if you're using Azure OpenAI
# BASE_URL=https://your-deployment-name.openai.azure.com/openai/deployments/your-deployment-id 

# Boltz configuration (optional)
BOLTZ_CACHE_DIR=~/.boltz
REDIS_HOST=localhost
CCD_PORT=7777
TAXONOMY_PORT=7778

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here 